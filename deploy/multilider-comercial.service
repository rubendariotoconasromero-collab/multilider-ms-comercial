[Unit]
Description=Multilider Comercial
After=network-online.target
Wants=network-online.target

[Service]
User=multilider-comercial
Group=multilider-comercial
WorkingDirectory=/var/www/multilider-ms-comercial/publish
ExecStart=/usr/bin/dotnet /var/www/multilider-ms-comercial/publish/MSMultilider.Comercial.dll
EnvironmentFile=/etc/multilider/comercial.env
Restart=on-failure
RestartSec=5
StateDirectory=multilider-comercial
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/multilider-comercial

[Install]
WantedBy=multi-user.target

